# Copy this file to .env.local for local development (it's git ignored),
# or add the same names in Vercel: Project → Settings → Environment Variables.
#
# Both values are public config, not secrets: they are built into the
# website's code. Your data is protected by the row level security rules
# in supabase/schema.sql. Never put the secret / service_role key here.
#
# Leave them empty and the app runs on the phone only, with no sync.

# Supabase → Project Settings → API Keys → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Older projects: use the "anon public" key instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
