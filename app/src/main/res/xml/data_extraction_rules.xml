<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The sign-in session and link tokens stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure.xml" />
    </device-transfer>
</data-extraction-rules>
